# --- Supabase (Lot 3) ---
# Copiez ce fichier en .env.local et remplissez les valeurs depuis
# Supabase → Project Settings → API.

# URL du projet (ex : https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (safe côté navigateur, protégée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRÈTE, jamais exposée au navigateur.
# Utilisée uniquement côté serveur (Server Actions / webhooks) pour les
# opérations privilégiées comme la commande invité.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lot 2 : paiement & notifications ---

# Agrégateur de paiement actif. `mock` = workflow de démo complet (valeurs
# prédéfinies, sans hub réel). `hub` = hub EdoctorPaiement (paiements réels).
PAYMENT_PROVIDER=mock

# --- Hub de paiement EdoctorPaiement (actif quand PAYMENT_PROVIDER=hub) ---
# Base API du hub (inclut /api-v1).
EDOCTOR_HUB_URL=https://payment.edoctor-tim.com/api-v1
# ServiceToken « sky-track » fourni par l'admin du hub (préfixe hub_...).
EDOCTOR_HUB_TOKEN=
# Secret de signature des webhooks (préfixe whsec_...) — le hub signe chaque
# webhook en HMAC-SHA256 (`X-Hub-Signature-256`), vérifié avant tout traitement.
EDOCTOR_HUB_WEBHOOK_SECRET=

# Canal de notification actif. `mock` = journalise la confirmation (console).
# À remplacer par `email` (Resend) / `whatsapp` (Cloud API) au branchement.
NOTIFY_PROVIDER=mock
